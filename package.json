{
  "name": "word-review-web",
  "private": true,
  "license": "0BSD",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run prepare:notices && tsc --noEmit && vite build",
    "prepare:notices": "node scripts/prepare-notices.mjs",
    "format": "prettier --write src scripts tests public/sw.js public/manifest.webmanifest *.json *.md index.html docs/*.md .github/**/*.yml",
    "format:check": "prettier --check src scripts tests public/sw.js public/manifest.webmanifest *.json *.md index.html docs/*.md .github/**/*.yml",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "package": "powershell.exe -NoProfile -File scripts/package.ps1",
    "test:package": "node --test tests/portable-server.test.mjs",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:pwa": "node tests/pwa-smoke.mjs",
    "prepare:sample": "node scripts/prepare-sample.mjs"
  },
  "dependencies": {
    "papaparse": "5.7.0",
    "read-excel-file": "9.3.12",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
